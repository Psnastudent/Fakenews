# Environment Variables for AI Fact Checker Backend
# Copy this file to .env and fill in your API keys

# Google Fact Check Tools API Key (free from Google Cloud Console)
GOOGLE_FACTCHECK_API_KEY=your_google_factcheck_api_key_here

# NewsAPI Key (free tier at newsapi.org)
NEWS_API_KEY=your_newsapi_key_here

# HuggingFace API Token (optional - for model downloads)
HUGGINGFACE_TOKEN=your_huggingface_token_here

# Server Config
HOST=0.0.0.0
PORT=8000
DEBUG=true
